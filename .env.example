# ==============================================================================
# SignalRecall — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# All variables in this file are read strictly on the server (Next.js Route
# Handlers, Auth.js config, and `lib/server/*` modules). None are prefixed with
# `NEXT_PUBLIC_`, so Next.js never bundles them into client-side browser code.
# Never commit real API keys, private keys, or OAuth secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PART 1: ACTIVE ENVIRONMENT VARIABLES (READ BY SIGNALRECALL CODE)
# ------------------------------------------------------------------------------

# 1. Tatum Data API & Sui RPC Gateway
# Read in: lib/server/tatum.ts
# Required for:
#   - Capturing live entry prices on signal creation (POST /api/signals)
#   - Running 24-hour signal verification (POST /api/signals/verify)
#   - Streaming spot prices (GET /api/market/prices)
#   - Querying Tatum Sui Mainnet JSON-RPC (GET /api/network/sui)
TATUM_API_KEY=

# 2. Walrus Memory SDK (@mysten-incubation/memwal)
# Read in: lib/server/walrus.ts
# Required for:
#   - Storing encrypted memories and signal audit facts (rememberAndWait)
#   - Running semantic vector recall for AI Chat & Chart Analysis (recall)
MEMWAL_SERVER_URL=
MEMWAL_ACCOUNT_ID=
MEMWAL_DELEGATE_KEY=
# Optional fallback key variable if MEMWAL_DELEGATE_KEY is not set:
MEMWAL_PRIVATE_KEY=
# Optional base namespace prefix (defaults to "signalrecall"; scoped per user as "<namespace>:<userId>"):
MEMWAL_NAMESPACE=

# 3. AI Inference Provider (OpenRouter)
# Read in: app/api/ai/chat/route.ts, app/api/ai/chart-analysis/route.ts
# Required for:
#   - Right-hand SignalRecall AI Assistant chat panel (POST /api/ai/chat)
#   - 1-click AI Technical Chart Scanner (POST /api/ai/chart-analysis)
OPENROUTER_API_KEY=
# Optional model override (defaults to "deepseek/deepseek-v4.1-flash"):
OPENROUTER_MODEL=

# 4. Google OAuth & Session Authentication (Auth.js v5 / next-auth)
# Read in: lib/auth.config.ts, lib/auth.ts, app/api/ai/chat/route.ts, app/api/ai/chart-analysis/route.ts
# Required for:
#   - Google Sign-In and per-user data isolation across signals, alerts, and memories
#   - Authorized Redirect URIs in Google Cloud Console:
#       http://localhost:3001/api/auth/callback/google
#       https://signal-recall.up.railway.app/api/auth/callback/google
# Note: Code checks AUTH_GOOGLE_ID first, then falls back to GOOGLE_CLIENT_ID
# (and AUTH_GOOGLE_SECRET, then GOOGLE_CLIENT_SECRET). Provide either pair:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign and encrypt Auth.js JWT session cookies (generate with `openssl rand -base64 33`):
AUTH_SECRET=
# Canonical application URL (used by Auth.js callbacks and OpenRouter HTTP-Referer header):
AUTH_URL=

# 5. Optional Market News & Fallback Exchange Keys
# Read in: app/api/market/news/route.ts (optional; powers Live Market Wire on /markets)
FINNHUB_API_KEY=

# Read in: lib/server/tatum.ts, app/api/market/candles/route.ts (optional; sent as X-MBX-APIKEY header)
BINANCE_API_KEY=

# Read in: lib/server/tatum.ts (optional; 3rd-tier fallback in fetch24hDeltas() when Binance & KuCoin fail)
CMC_PRO_API_KEY=

# ------------------------------------------------------------------------------
# PART 2: PLANNED / RESERVED VARIABLES (NOT CURRENTLY READ BY CODE)
# ------------------------------------------------------------------------------
# The variables below are reserved for future integrations and are NOT read by
# any module in the current codebase:
TATUM_ENV=
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
GEMINI_API_KEY=
CRYPTOPANIC_API_KEY=
CRYPTORANK_API_KEY=
