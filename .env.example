# ==============================================================================
# SignalRecall — Technical Source of Truth & Environment Configuration
# ==============================================================================
# All API keys, tokens, and secrets in this file are SERVER-SIDE ONLY.
# Next.js will NOT expose these variables to the browser bundle.
# Never hardcode, expose, or log API keys or secrets.
#
# TECHNICAL SOURCES OF TRUTH:
#
# TATUM:
# - Documentation: https://docs.tatum.io/
# - API Reference: https://docs.tatum.io/reference/welcome-to-the-tatum-api-reference
# - Exchange Rates API: https://tatum.io/products/exchange-rates/
# - Supported Chains: https://tatum.io/chain
# - Sui RPC Gateway: https://docs.tatum.io/reference/rpc-sui
#
# WALRUS MEMORY:
# - Walrus Protocol Docs: https://docs.walrus.site/
# - Walrus Core GitHub: https://github.com/MystenLabs/walrus
# - Walrus Memory (MemWal): https://github.com/MystenLabs/walrus-memory
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Tatum API (REQUIRED for live spot rates & 24h objective verification)
# ------------------------------------------------------------------------------
# Get your API key at https://tatum.io/
# Authentication: x-api-key header passed to https://api.tatum.io
# Documented Endpoints Used:
#   - Single Rate: GET /v4/data/rate/symbol?symbol={symbol}&basePair=USD
#   - Batch Rates: POST /v4/data/rate/symbol/batch (payload: [{batchId, symbol, basePair}])
#   - Fallback Rate: GET /v3/tatum/rate/{currency}?basePair=USD
#   - Sui RPC: https://sui-mainnet.gateway.tatum.io (or testnet)
TATUM_API_KEY=

# Tatum Environment: "mainnet" or "testnet" (default: mainnet)
TATUM_ENV=mainnet

# ------------------------------------------------------------------------------
# 2. Walrus Protocol & Walrus Memory (REQUIRED for decentralized memory storage)
# ------------------------------------------------------------------------------
# Official Walrus Testnet HTTP API endpoints:
#   - Publisher (Upload): PUT /v1/blobs?epochs={epochs}
#   - Aggregator (Read):  GET /v1/blobs/{blobId}
# Reference: https://docs.walrus.site/
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# ------------------------------------------------------------------------------
# 3. AI Intelligence Provider (OpenRouter or Google Gemini)
# ------------------------------------------------------------------------------
# Get your API key at https://openrouter.ai/keys
# Supported models: deepseek/deepseek-v4.1-flash (or snapshot: deepseek/deepseek-v4.1-flash-1017)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Or Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Market News & Catalysts (CoinMarketCap or CryptoPanic)
# ------------------------------------------------------------------------------
# Get a free developer API key at https://pro.coinmarketcap.com/
CMC_PRO_API_KEY=
# Or CryptoPanic: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. Macroeconomic Calendar (Finnhub)
# ------------------------------------------------------------------------------
# Get a free API key at https://finnhub.io/ (CPI, FOMC, Fed interest rate decisions)
FINNHUB_API_KEY=

# ------------------------------------------------------------------------------
# 6. Token Unlocks & Vesting Schedules
# ------------------------------------------------------------------------------
# CryptoRank API: https://cryptorank.io/api (/v3/currencies/upcoming-token-unlocks)
CRYPTORANK_API_KEY=

# ------------------------------------------------------------------------------
# 7. Authentication & Google OAuth (REQUIRED for user workspaces & data isolation)
# ------------------------------------------------------------------------------
# Framework: NextAuth.js (Auth.js v5)
# Documentation: https://authjs.dev/getting-started/providers/google
#
# GOOGLE CLOUD CONSOLE SETUP:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create or select a Project (e.g., "SignalRecall").
# 3. Configure OAuth consent screen:
#    - User Type: External
#    - App Name: SignalRecall
#    - User support & developer contact email
#    - Scopes: .../auth/userinfo.email, .../auth/userinfo.profile, openid
# 4. Under Credentials > Create Credentials > OAuth client ID:
#    - Application type: Web application
#    - Name: SignalRecall Web Client
#    - Authorized JavaScript origins:
#        http://localhost:3001
#        (and your production domain, e.g., https://signalrecall.xyz)
#    - Authorized redirect URIs:
#        http://localhost:3001/api/auth/callback/google
#        (and https://your-domain.com/api/auth/callback/google)
# 5. Copy the generated Client ID and Client Secret below:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Secret key used to encrypt and sign JWT session cookies.
# Generate a secure 32+ byte string using:
#   openssl rand -base64 33
#   or: npx auth secret
AUTH_SECRET=

# Canonical host URL of the app (default: http://localhost:3001)
AUTH_URL=http://localhost:3001

